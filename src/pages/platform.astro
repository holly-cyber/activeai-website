---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Loop from '../components/sections/Loop.astro';
import Score from '../components/sections/Score.astro';
import Moments from '../components/sections/Moments.astro';
import Science from '../components/sections/Science.astro';
import Dashboard from '../components/sections/Dashboard.astro';
import Integration from '../components/sections/Integration.astro';
import Crm from '../components/sections/Crm.astro';
import Beta from '../components/sections/Beta.astro';
import { SCORE } from '../config/site';
---
<Base
  title="Platform"
  description={`How Active AI works: the ${SCORE.name}, the nine moments, the partner dashboard and three ways to plug in: a branded app, an API into your app, or straight to your CRM.`}
>
  <PageHero eyebrow="Platform" title="The momentum engine, in more depth.">
    Everything a digital or technical lead needs to judge the fit: how the loop works, what the {SCORE.name} tells you,
    how moments are timed and held back, and the three ways to plug in.
  </PageHero>
  <Loop id="loop" />
  <Score />
  <Moments />
  <Science depth />
  <Dashboard />
  <Integration />
  <Crm />
  <Beta />
</Base>
