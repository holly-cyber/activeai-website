---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import heroImage from '../assets/public-sector-hero.jpg';
import PublicSector from '../components/sections/PublicSector.astro';
import { publicSectorMailto, CONTACT } from '../config/site';
---
<Base
  title="Public sector partners"
  description="The Active AI momentum engine for councils, active travel, public health, sport governing bodies and physical activity partners: getting people moving and keeping them moving. WeRoam shows how."
>
  <section class="ps-hero band band--navy" aria-labelledby="page-title">
    <Picture
      src={heroImage}
      alt="Two women walking together through a town centre on an autumn morning."
      class="ps-hero-img"
      widths={[640, 960, 1440, 1920, 2880]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap inner">
      <p class="eyebrow">Public sector partners</p>
      <h1 id="page-title">Same engine. Different outcome.</h1>
    </div>
  </section>
  <PublicSector />

  <section class="band band--chalk" aria-labelledby="ps-next-title">
    <div class="wrap next">
      <p class="eyebrow">Next step</p>
      <h2 id="ps-next-title">Got a programme to get people moving?</h2>
      <p class="lede muted">Tell us about your residents or members and what you need to show your funders. We will come back with how the engine would work for you.</p>
      <a class="btn btn--primary" href={publicSectorMailto()}>Talk to us <span aria-hidden="true">→</span></a>
      <p class="muted small">Or email <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
    </div>
  </section>
</Base>

<style>
  .ps-hero { position: relative; overflow: hidden; padding: 0; display: grid; }
  .ps-hero :global(.ps-hero-img) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 48% 30%; }
  .inner { padding-block: 2rem 3rem; }
  .inner .eyebrow { margin: 0 0 0.75rem; }
  h1 { font-size: var(--step-4); max-width: 22ch; text-wrap: balance; margin: 0; }

  /* Desktop: the photo fills the hero and the title sits on a navy fade at the foot. */
  @media (min-width: 900px) {
    .ps-hero { min-height: min(82vh, 820px); align-items: end; }
    .ps-hero :global(.ps-hero-img) { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; object-position: 50% 35%; }
    .ps-hero::before {
      content: ''; position: absolute; inset: 0; z-index: 1;
      background:
        linear-gradient(0deg, rgba(0, 0, 54, 0.96) 0%, rgba(0, 0, 54, 0.8) 25%, rgba(0, 0, 54, 0) 55%),
        linear-gradient(90deg, rgba(0, 0, 54, 0.55) 0%, rgba(0, 0, 54, 0.25) 35%, rgba(0, 0, 54, 0) 55%);
    }
    .inner { position: relative; z-index: 2; padding-block: 0 clamp(2.5rem, 2rem + 2vw, 4rem); }
  }

  .next { display: grid; gap: 1.25rem; justify-items: start; }
  .next .eyebrow, .next p, .next h2 { margin: 0; }
  .small { font-size: 0.9rem; }
</style>
