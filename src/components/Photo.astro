---
/**
 * Photography slot. Pass an imported image (astro:assets) once Holly supplies
 * licensed files; until then it renders a clearly marked placeholder.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  /** What should go here, shown on the placeholder. */
  brief: string;
  ratio?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { src, alt, brief, ratio = '4 / 3', eager = false, sizes = '(min-width: 1040px) 33vw, 100vw', class: className } = Astro.props;
---
{src ? (
  <Picture
    src={src}
    alt={alt}
    class:list={['photo', className]}
    style={`aspect-ratio:${ratio}`}
    widths={[400, 800, 1200, 1600]}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
) : (
  <div class:list={['photo', 'placeholder', className]} style={`aspect-ratio:${ratio}`} role="img" aria-label={alt}>
    <span class="label">Photo placeholder</span>
    <span class="brief">{brief}</span>
  </div>
)}

<style>
  .photo { width: 100%; height: auto; object-fit: cover; border-radius: var(--radius); display: block; }
  .placeholder {
    display: flex; flex-direction: column; justify-content: flex-end; gap: 0.3rem; padding: 1rem;
    background:
      linear-gradient(160deg, rgba(0, 194, 255, 0.22), transparent 55%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0 12px, transparent 12px 24px),
      linear-gradient(200deg, #1e1e6e, #000036);
    color: var(--chalk);
    border: 1px dashed rgba(200, 178, 115, 0.6);
  }
  .placeholder .label { color: var(--gold); }
  .brief { font-size: 0.9rem; line-height: 1.35; }
</style>
