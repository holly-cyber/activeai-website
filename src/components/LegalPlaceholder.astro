---
/**
 * LAUNCH BLOCKER: the live privacy and cookie policies must be carried across
 * word for word from the current Netlify deploy (brief §4). Do not rewrite them.
 * Replace this component's use in /privacy and /cookies with the ported text,
 * then drop the `noindex` flag on those pages.
 */
import { CONTACT } from '../config/site';
interface Props { title: string }
const { title } = Astro.props;
---
<section class="band band--chalk">
  <div class="wrap prose">
    <p class="eyebrow">Legal</p>
    <h1>{title}</h1>
    <p class="note"><strong>Placeholder.</strong> The current policy is being carried across unchanged from the live site.</p>
    <p>In the meantime, questions about this policy can go to <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.</p>
  </div>
</section>

<style>
  h1 { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .note { background: var(--white); border-left: 3px solid var(--gold); padding: 1rem; }
</style>
