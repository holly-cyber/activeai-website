---
/**
 * Phone mock-up for app screens. Pass an imported PNG export (3×) as `src`;
 * until the exports arrive it shows a labelled placeholder screen.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  screen: string;
  alt: string;
  src?: ImageMetadata;
  class?: string;
}
const { screen, alt, src, class: className } = Astro.props;
---
<figure class:list={['phone', className]}>
  <div class="frame">
    {src ? (
      <Image src={src} alt={alt} widths={[260, 390, 520]} sizes="(min-width: 760px) 260px, 60vw" class="screen" loading="lazy" />
    ) : (
      <div class="screen placeholder" role="img" aria-label={alt}>
        <span class="notch" aria-hidden="true"></span>
        <span class="label">App screen placeholder</span>
        <span class="name">{screen}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
    )}
  </div>
  <figcaption class="label">{screen}</figcaption>
</figure>

<style>
  .phone { margin: 0; width: 100%; max-width: 250px; display: grid; gap: 0.75rem; justify-items: center; }
  .frame { width: 100%; aspect-ratio: 9 / 19.5; border-radius: 34px; padding: 9px; background: #0c0c24; box-shadow: 0 0 0 1px rgba(255,255,255,0.12), 0 24px 50px -20px rgba(0,0,0,0.55); }
  .screen { width: 100%; height: 100%; border-radius: 26px; object-fit: cover; }
  .placeholder {
    position: relative; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 0.6rem; text-align: center; padding: 1.25rem;
    background: linear-gradient(170deg, #1b1b66 0%, #000036 70%); color: var(--chalk);
  }
  .notch { position: absolute; top: 10px; width: 34%; height: 18px; border-radius: 12px; background: #0c0c24; }
  .placeholder .label { color: var(--gold); font-size: 0.62rem; }
  .name { font-family: var(--font-display); font-size: 1.9rem; line-height: 1; text-transform: uppercase; }
  .bars { display: grid; gap: 6px; width: 70%; margin-top: 0.75rem; }
  .bars i { display: block; height: 8px; border-radius: 4px; background: rgba(244,241,236,0.14); }
  .bars i:first-child { background: var(--electric); width: 72%; }
  figcaption { color: inherit; opacity: 0.85; }
</style>
