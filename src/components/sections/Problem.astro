---
import Photo from '../Photo.astro';
import runnerWatch from '../../assets/problem/runner-watch.jpg';
import cyclist from '../../assets/problem/cyclist.jpg';
const cols = [
  {
    title: 'Timing is the whole game',
    body: 'Your athlete just ran a personal best, and you send them the same email as everyone else. The moment they were ready to buy has already passed.',
    photo: 'A runner at dusk, glancing down at her sports watch mid-run.',
    src: runnerWatch,
  },
  {
    title: 'Data without intelligence',
    body: 'Wearable, app and CRM data sit in separate systems. Nothing turns them into a live buying signal, and your view ends at checkout.',
    photo: 'A road cyclist mid-ride on a mountain road.',
    src: cyclist,
  },
];
---
<section id="problem" class="band band--chalk" aria-labelledby="problem-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">The problem</p>
      <h2 id="problem-title">Sports brands are flying blind.</h2>
    </div>
    <div class="grid grid--3">
      {cols.map((c) => (
        <article>
          <Photo src={c.src} alt={c.photo} brief={`Problem: ${c.photo}`} ratio="3 / 2" />
          <h3 class="ruled">{c.title}</h3>
          <p class="muted">{c.body}</p>
        </article>
      ))}
      <article class="stat">
        <p class="label">Revenue left on the table</p>
        <p class="big">13×</p>
        <p>Triggered offers out-sell campaign email: 2.11% of recipients buy, against 0.16%.</p>
        <p class="source">Source: Klaviyo 2026 benchmarks, share of recipients who buy: automated flows vs campaigns.</p>
      </article>
    </div>
    <p class="closer">Active AI moves sports brands from <strong class="nowrap">campaign-led</strong> selling to <strong class="nowrap">behaviour-led</strong> revenue.</p>
  </div>
</section>

<style>
  article { display: grid; gap: 1rem; align-content: start; }
  h3 { font-size: var(--step-2); margin-top: 0.5rem; }
  .stat { background: var(--navy); color: var(--chalk); border-radius: var(--radius-lg); padding: clamp(1.5rem, 1rem + 2vw, 2.25rem); align-content: center; }
  .stat p { margin: 0; }
  .stat .label { color: var(--on-navy-muted); }
  .big { font-family: var(--font-mono); font-size: clamp(3.5rem, 2.5rem + 4vw, 5.5rem); line-height: 1; color: var(--gold); }
  .source { font-size: 0.8rem; color: var(--on-navy-muted); }
  .closer { margin-top: 3rem; font-size: var(--step-1); max-width: 40ch; }
  .nowrap { white-space: nowrap; }
  /* One line on desktop. */
  @media (min-width: 1040px) { .closer { max-width: none; } }
</style>
