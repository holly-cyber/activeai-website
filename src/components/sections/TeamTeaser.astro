---
import { getCollection } from 'astro:content';
import Headshot from '../Headshot.astro';
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---
<section id="team" class="band band--white" aria-labelledby="team-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">The team</p>
      <h2 id="team-title">The people who built this, and who will scale it.</h2>
    </div>
    <ul role="list" class="grid grid--4">
      {team.map(({ id, data }) => (
        <li>
          <Headshot id={id} name={data.name} />
          <h3>{data.name}</h3>
          <p class="label role">{data.role}</p>
          <p class="muted">{data.short}</p>
        </li>
      ))}
    </ul>
    <p class="more"><a href="/about">Meet the team <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: grid; gap: 0.5rem; align-content: start; }
  h3 { font-size: var(--step-1); letter-spacing: 0.04em; margin-top: 1rem; }
  .role { color: var(--accent-text); margin: 0; }
  li p { margin: 0; font-size: 0.95rem; }
  .more { margin-top: 2rem; font-weight: 500; }
</style>
