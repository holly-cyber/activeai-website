---
// D-W4: every figure here is illustrative and the brand is an example.
const kpis = [
  { k: 'Moments fired', v: '1,204' },
  { k: 'Lift vs control', v: '+2.4 pts' },
  { k: 'Revenue lift', v: '£48.2K' },
  { k: 'Peaking this week', v: '312' },
];
const mix = [
  { b: 'Building', w: 52 },
  { b: 'Peaking', w: 11 },
  { b: 'Stalling', w: 37 },
];
const features = [
  { k: 'Every moment, in real time', t: 'Every moment and window, and each sale matched to its moment.' },
  { k: 'Lift you can prove', t: "Each moment is measured against a control group that didn't get it." },
  { k: 'Which moments work', t: 'See which moments sell your catalogue, and tune it without code.' },
];
---
<section id="dashboard" class="band band--chalk" aria-labelledby="dashboard-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Partner dashboard</p>
      <h2 id="dashboard-title">You see what worked, and you can prove it.</h2>
    </div>

    <figure class="portal" aria-labelledby="portal-cap">
      <figcaption id="portal-cap" class="visually-hidden">
        Illustrative partner portal for an example brand: moments fired, lift against a control group, revenue lift,
        athletes peaking this week, and how this week's athletes split between building, peaking and stalling.
      </figcaption>
      <div class="top">
        <p class="label">Partner portal · Fell &amp; Field (example brand)</p>
        <span class="tag illus">Illustrative</span>
      </div>
      <dl class="kpis">
        {kpis.map((k) => <div><dt class="label">{k.k}</dt><dd>{k.v}</dd></div>)}
      </dl>
      <div class="mix">
        <p class="label">Your athletes this week</p>
        <div class="stack" aria-hidden="true">
          {mix.map((m, i) => <span class={`s s${i}`} style={`flex:${m.w}`}></span>)}
        </div>
        <ul role="list" class="legend">
          {mix.map((m, i) => <li><span class={`dot s${i}`}></span>{m.b} {m.w}%</li>)}
        </ul>
      </div>
    </figure>

    <ul role="list" class="grid grid--3 features">
      {features.map((f) => <li><h3>{f.k}</h3><p class="muted">{f.t}</p></li>)}
    </ul>
  </div>
</section>

<style>
  .portal { margin: 0; background: var(--white); border: 1px solid var(--rule-light); border-radius: var(--radius-lg); padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem); display: grid; gap: 1.5rem; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .top p { margin: 0; }
  .illus { color: var(--ink-muted); border-color: var(--rule-light); background: var(--chalk); white-space: nowrap; }
  .kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin: 0; }
  @media (min-width: 820px) { .kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .kpis div { border: 1px solid var(--rule-light); border-radius: var(--radius); padding: 1rem 1.1rem; }
  .kpis dt { color: var(--ink-muted); font-size: 0.75rem; }
  .kpis dd { margin: 0.4rem 0 0; font-family: var(--font-mono); font-size: clamp(1.3rem, 0.9rem + 1.6vw, 2.6rem); line-height: 1; white-space: nowrap; }
  .mix .label { color: var(--ink-muted); margin: 0 0 0.75rem; }
  .stack { display: flex; height: 18px; border-radius: 4px; overflow: hidden; }
  .legend { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1rem; font-size: 0.9rem; }
  .legend li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .s0 { background: var(--electric); }
  .s1 { background: var(--gold); }
  .s2 { background: #d9d4cb; }
  .features { list-style: none; padding: 0; margin: 2rem 0 0; }
  .features h3 { font-family: var(--font-body); font-weight: 600; text-transform: none; letter-spacing: 0; font-size: var(--step-1); line-height: 1.3; margin-bottom: 0.3rem; }
  .features p { margin: 0; }
</style>
