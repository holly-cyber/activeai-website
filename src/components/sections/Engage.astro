---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Phone from '../Phone.astro';
const blocks = (await getCollection('engage')).sort((a, b) => a.data.order - b.data.order);
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*.png', { eager: true });
const screen = (name: string) => {
  const hit = files[`../../assets/screens/${name}.png`];
  if (!hit) throw new Error(`No app screen called ${name}.png in src/assets/screens`);
  return hit.default;
};
---
<section id="engage" class="band band--navy" aria-labelledby="engage-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">How athletes engage</p>
      <h2 id="engage-title">Crews, challenges and routes.</h2>
      <p class="lede muted">Sessions, crews, challenges and routes keep athletes active between purchases, and every one of them feeds their momentum.</p>
    </div>

    <div class="tabs" data-tabs>
      <div class="tablist" role="tablist" aria-label="Engagement features" hidden>
        {blocks.map(({ id, data }, i) => (
          <button role="tab" type="button" id={`tab-${id}`} aria-controls={`panel-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="label">{data.eyebrow}</span>
            <span class="tt">{data.title}</span>
          </button>
        ))}
      </div>

      {blocks.map(({ id, data }) => (
        <article class="panel" id={`panel-${id}`} aria-labelledby={`h-${id}`}>
          <div class="text">
            <p class="eyebrow">{data.title}</p>
            <h3 id={`h-${id}`}>{data.headline}</h3>
            <p class="muted">{data.intro}</p>
            {data.callout && (
              <p class="callout"><span class="v">{data.callout.value}</span> <span>{data.callout.text}</span></p>
            )}
            <ol role="list" class="points">{data.points.map((p) => <li>{p}</li>)}</ol>
            <p class="privacy"><span class="label">Athlete-first</span> {data.privacy}</p>
          </div>
          <div class:list={['screens', `n${data.screens.length}`]}>
            {data.screens.map((s) => <Phone screen={s.name} alt={s.alt} src={screen(s.file)} />)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Tabs at every width, so phones show one story at a time. Without JavaScript the panels stay stacked.
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = j === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = j !== i));
      if (focus) tabs[i].focus();
    };

    list.hidden = false;
    panels.forEach((p, j) => { p.setAttribute('role', 'tabpanel'); p.setAttribute('aria-labelledby', tabs[j].id); p.tabIndex = 0; });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
        if (next !== undefined) { e.preventDefault(); select(next, true); }
      });
    });
    select(0);
  }
</script>

<style>
  /* Let the intro run the full width on desktop. */
  @media (min-width: 1040px) { .section-head, .section-head .lede { max-width: none; } }
  .tablist { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; margin-bottom: 1.75rem; }
  @media (min-width: 900px) { .tablist { gap: 0.75rem; margin-bottom: 2.5rem; } }
  .tablist[hidden] { display: none; }
  [role='tab'] {
    display: grid; gap: 0.3rem; text-align: left; cursor: pointer; background: transparent; color: var(--chalk);
    border: 1px solid var(--rule-dark); border-radius: var(--radius); padding: 0.75rem 0.7rem; font: inherit; align-content: start;
  }
  @media (min-width: 900px) { [role='tab'] { padding: 1rem 1.25rem; } }
  [role='tab'] .label { color: var(--gold); }
  .tt { font-family: var(--font-display); font-size: clamp(1.3rem, 1rem + 1.5vw, 1.8rem); line-height: 1; text-transform: uppercase; }
  [role='tab'][aria-selected='true'] { background: var(--navy-3); border-color: var(--electric); box-shadow: inset 0 -3px 0 var(--electric); }
  [role='tab']:hover { border-color: var(--chalk); }

  .panel { display: grid; gap: 2rem; align-items: center; padding-block: 2rem; border-top: 1px solid var(--rule-dark); }
  .panel[hidden] { display: none; }
  .tablist:not([hidden]) ~ .panel { border-top: 0; padding-top: 0; }
  @media (min-width: 900px) { .panel { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .text { display: grid; gap: 1rem; align-content: start; }
  .text .eyebrow { margin: 0; }
  h3 { font-size: var(--step-3); }
  .text p { margin: 0; }
  .callout { display: flex; align-items: center; gap: 1rem; margin: 0.5rem 0 !important; }
  .callout .v { font-family: var(--font-mono); font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem); line-height: 1; color: var(--gold); white-space: nowrap; }
  .points { margin: 0; padding: 0; list-style: none; display: grid; counter-reset: pt; }
  .points li { counter-increment: pt; display: grid; grid-template-columns: 2.25rem 1fr; padding: 0.75rem 0; border-top: 1px solid var(--rule-dark); }
  .points li:last-child { border-bottom: 1px solid var(--rule-dark); }
  .points li::before { content: counter(pt, decimal-leading-zero); font-family: var(--font-mono); color: var(--electric); padding-top: 0.1rem; }
  .privacy { background: rgba(200, 178, 115, 0.1); border-left: 3px solid var(--gold); padding: 0.8rem 1rem; border-radius: 0 8px 8px 0; font-size: 0.95rem; }
  .privacy .label { color: var(--gold); display: block; margin-bottom: 0.2rem; }
  .screens { display: grid; gap: 1rem; justify-items: center; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .screens.n3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .screens :global(.phone) { max-width: 210px; }
  .screens.n2 :global(.phone:nth-child(2)) { margin-top: 2.5rem; }
  /* Phones: every screen in a swipeable row that bleeds to the screen edge. */
  @media (max-width: 599px) {
    .screens, .screens.n3 {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(58vw, 230px); justify-items: stretch;
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter)); padding: 0.5rem var(--gutter) 1.5rem; scroll-padding-inline: var(--gutter);
    }
    .screens::-webkit-scrollbar { display: none; }
    .screens :global(.phone) { max-width: none; scroll-snap-align: start; }
    .screens.n2 :global(.phone:nth-child(2)) { margin-top: 0; }
  }
</style>
