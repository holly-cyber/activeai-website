---
import { getCollection } from 'astro:content';
const moments = (await getCollection('moments')).sort((a, b) => a.data.order - b.data.order);
const top = moments.find((m) => m.data.featured)!;
const rest = moments.filter((m) => m !== top);
---
<section id="moments" class="band band--navy" aria-labelledby="moments-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">The nine moments</p>
      <h2 id="moments-title">Nine moments. The right one fires at the right time.</h2>
    </div>
    <div class="grid-m">
      <article class="top">
        <p class="label">Top moment</p>
        <h3>{top.data.name}</h3>
        {top.data.summary && <p>{top.data.summary}</p>}
        <p class="window">{top.data.window}</p>
      </article>
      <ul role="list" class="rest">
        {rest.map(({ data }) => (
          <li>
            <h3>{data.name}</h3>
            <p class="window"><span class="visually-hidden">Window: </span>{data.window}</p>
          </li>
        ))}
      </ul>
    </div>
    <p class="closer">
      Every moment ships with its own control-group result. When an athlete stalls, nothing fires and the coach steps in
      instead. That's enforced in the engine, not left to policy.
    </p>
  </div>
</section>

<style>
  .grid-m { display: grid; gap: 0.9rem; }
  @media (min-width: 900px) { .grid-m { grid-template-columns: 1fr 2.6fr; } }
  .top { background: var(--gold); color: var(--navy); border-radius: var(--radius-lg); padding: 1.75rem; display: grid; gap: 0.75rem; align-content: start; }
  .top p { margin: 0; }
  .top h3 { font-size: var(--step-3); }
  .top .window { font-family: var(--font-mono); margin-top: 0.75rem; }
  .rest { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1040px) { .rest { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .rest li { background: var(--navy-2); border-radius: var(--radius); padding: 1.1rem 1.2rem 1.3rem; display: grid; gap: 0.5rem; align-content: start; }
  .rest h3 { font-family: var(--font-body); font-weight: 600; text-transform: none; letter-spacing: 0; font-size: 1.05rem; line-height: 1.25; }
  .rest .window { margin: 0; font-family: var(--font-mono); font-size: 0.9rem; color: var(--on-navy-muted); }
  .closer { margin-top: 2.5rem; font-size: var(--step-1); max-width: 60ch; color: var(--gold); font-weight: 500; }
</style>
