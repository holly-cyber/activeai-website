---
const options = [
  {
    tag: '01 · Branded app',
    title: 'Our app, your brand',
    lede: 'A white-label athlete app in your colours, live on the App Store and Google Play. Moments, a reward vault and one nudge at a time. We run it, store updates included.',
    fit: 'Best if you have no athlete app yet.',
  },
  {
    tag: '02 · API into your app',
    title: 'Your app, our engine',
    lede: 'Moments delivered into the app your athletes already use, through our versioned Partner API and ready-made components: moment card, offer reveal, crew table, markers map.',
    fit: 'Best if you already have an app.',
  },
  {
    tag: '03 · API into your CRM',
    title: 'Straight to your CRM',
    lede: 'Moments land in the CRM you already use as a ready-to-send event. Your templates, your offer.',
    fit: 'Best if your list is your channel.',
  },
];
---
<section id="integration" class="band band--white" aria-labelledby="integration-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">How it plugs in</p>
      <h2 id="integration-title">Three ways in. Start where you are.</h2>
    </div>
    <div class="grid grid--3">
      {options.map((o, i) => (
        <article class:list={['opt', `o${i}`]}>
          <p class="label t">{o.tag}</p>
          <h3>{o.title}</h3>
          <p class="lead">{o.lede}</p>
          <p class="fit">{o.fit}</p>
        </article>
      ))}
    </div>
    <p class="closer">You receive the moment, never raw activity, health data or the score.</p>
  </div>
</section>

<style>
  /* Three columns are too narrow for the cards below 1040px, so stack them. */
  @media (min-width: 760px) and (max-width: 1039px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  .opt { border-radius: var(--radius-lg); padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem); background: var(--chalk); border: 1px solid var(--rule-light); display: grid; gap: 1rem; grid-template-rows: auto auto 1fr auto; grid-template-columns: minmax(0, 1fr); container-type: inline-size; }
  .opt.o2 { background: var(--navy); color: var(--chalk); border-color: var(--navy); box-shadow: inset 0 4px 0 var(--electric); }
  .t { margin: 0; color: var(--accent-text); }
  .o2 .t { color: var(--on-navy-muted); }
  h3 { font-size: var(--step-3); }
  .lead { margin: 0; color: var(--ink-muted); }
  .o2 .lead { color: var(--on-navy-muted); }
  .fit { margin: 0.5rem 0 0; padding: 0.8rem 1rem; border-radius: 999px; text-align: center; font-weight: 600; background: #ebe6dc;
    /* Shrink to stay on one line inside the card. */
    white-space: nowrap; font-size: clamp(0.7rem, calc((100cqi - 2rem) / 21), 0.95rem); }
  .o1 .fit { background: #e0f6ff; }
  .o2 .fit { background: var(--electric); color: var(--navy); }
  .closer { margin-top: 2.5rem; font-size: var(--step-1); font-weight: 600; max-width: 50ch; }
</style>
