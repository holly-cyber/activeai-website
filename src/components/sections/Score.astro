---
import { SCORE } from '../../config/site';
const layers = [
  { name: 'Physical activity', text: 'Movement, effort and performance signals from wearables and the app.' },
  { name: 'Engagement', text: 'How athletes use the app: challenges, crews and community.' },
  { name: 'Context', text: 'Situational signals that sharpen the picture.' },
];
const bands = ['Stable', 'Rising', 'Intent', 'Momentum', 'Peak'];
---
<section id="score" class="band band--chalk" aria-labelledby="score-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">The score</p>
      <h2 id="score-title">The {SCORE.name}.</h2>
      <p class="lede muted">
        A real-time score for every athlete, built from several layers of behavioural signal. When it says the moment
        is right, the right Momentum Unlock fires. How the layers combine is ours to keep.
      </p>
    </div>
    <div class="grid grid--3">
      {layers.map((l) => (
        <article class="ruled">
          <p class="label layer">Signal layer</p>
          <h3>{l.name}</h3>
          <p class="muted">{l.text}</p>
        </article>
      ))}
    </div>
    <div class="bands">
      <p class="label">Score bands</p>
      <ul role="list">
        {bands.map((b, i) => <li class={`b b${i}`}>{b}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  h3 { font-size: var(--step-2); margin: 0.4rem 0 0.6rem; }
  .layer { color: var(--accent-text); margin: 0; }
  .bands { margin-top: 3rem; display: grid; gap: 1rem; }
  .bands .label { margin: 0; color: var(--ink-muted); }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .b { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.55rem 1rem; border-radius: 999px; border: 1px solid var(--navy); }
  .b3 { background: var(--navy-3); color: var(--chalk); border-color: var(--navy-3); }
  .b4 { background: var(--electric); color: var(--navy); border-color: var(--electric); font-weight: 500; }
</style>
